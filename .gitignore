# Python
__pycache__/
*.py[cod]

# 仮想環境(絶対にコミットしない・容量がデカく不要)
venv/
.venv/

# ★秘密情報(SECRET_KEY / Cloudinaryのキーなど)
# このリポジトリは公開なので、コミットすると全世界に漏れる。絶対に無視する。
.env
.env.*
!.env.example

# データベース(SQLite)。手元のデータなので共有しない
*.db
*.sqlite
*.sqlite3
instance/

# OS
Thumbs.db
.DS_Store

# エディタ設定(settings.json だけは共有して、家PC/会社PCの環境を揃える)
.vscode/*
!.vscode/settings.json
